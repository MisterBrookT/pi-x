#!/usr/bin/env node
// Which Claude account pi uses (accountkit). No /reload needed; read on every request.
//   claude-route            list accounts, % left, active
//   claude-route <name>     pin one account (minarabench, own, ...)
//   new profile login:      CLAUDE_CONFIG_DIR=~/.claude-<name> claude /login
//   claude-route auto       highest band of % left; ties keep the current one (band width: ~/.pix/accounts.json "band", default 25)
import { createJiti } from "jiti";
import { fileURLToPath } from "node:url";
const jiti = createJiti(fileURLToPath(import.meta.url));
const k = await jiti.import(new URL("../plugins/pix-anthropic/accountkit.ts", import.meta.url).pathname);
const arg = process.argv[2];
const ids = k.accounts().map(a => a.id);
if (arg) {
  const v = arg;
  if (v !== "auto" && !ids.includes(v)) { console.error(`usage: claude-route [auto|${ids.join("|")}]`); process.exit(2); }
  k.setChoice(v);
}
const u = k.usage(), active = k.plan()[0]?.id, now = Date.now();
console.log(`mode: ${k.choice()}  (bands of ${k.bandWidth()}%)`);
for (const a of k.accounts()) {
  const x = u[a.id] ?? {};
  const left = x.left === undefined ? "% left unknown" : `${Math.round(x.left)}% left`;
  const cool = x.coolUntil && now < x.coolUntil ? `, resting until ${new Date(x.coolUntil).toLocaleTimeString()}` : "";
  console.log(`${a.id === active ? "▸" : " "} ${a.id.padEnd(12)} ${k.ready(a) ? left : "not logged in: CLAUDE_CONFIG_DIR=" + a.configDir + " claude /login"}${cool}`);
}
