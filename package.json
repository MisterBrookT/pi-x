{
  "name": "pi-pix",
  "version": "0.1.0",
  "description": "A focused Pi package: web access, bounded subagents, visible todo tracking, LSP diagnostics, Claude CLI models, and health checks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "subagents",
    "web-search",
    "lsp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisterBrookT/pix.git"
  },
  "homepage": "https://github.com/MisterBrookT/pix#readme",
  "bugs": {
    "url": "https://github.com/MisterBrookT/pix/issues"
  },
  "scripts": {
    "check": "node --test && npm run prompt:snapshot",
    "prompt:snapshot": "node scripts/render-prompt-comparison.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "pi-subagents": "0.63.0",
    "pi-web-access": "0.27.0",
    "@narumitw/pi-lsp": "0.49.6",
    "cross-spawn": "7.0.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts",
      "./node_modules/pi-subagents/index.ts",
      "./node_modules/pi-web-access/index.ts",
      "./node_modules/@narumitw/pi-lsp/dist/index.ts",
      "./vendor/pi-claude-cli/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "config",
    "docs",
    "extensions",
    "scripts",
    "src",
    "tests",
    "vendor",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ]
}
