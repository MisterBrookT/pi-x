{
  "name": "@brooktang/pi-x",
  "version": "0.5.1",
  "description": "A focused Pi package: web access, bounded subagents, visible todo tracking, computer use, LSP diagnostics, and health checks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "subagents",
    "web-search",
    "lsp",
    "computer-use"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisterBrookT/pi-x.git"
  },
  "homepage": "https://github.com/MisterBrookT/pi-x#readme",
  "bugs": {
    "url": "https://github.com/MisterBrookT/pi-x/issues"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "check": "node --test && npm run prompt:snapshot",
    "test:tui": "node --test tests/tui-*.test.mjs",
    "prompt:snapshot": "node scripts/render-prompt-comparison.mjs",
    "smoke:anthropic": "node scripts/smoke-pix-anthropic.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "^1.2.2",
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/keyring": "^1.3.0",
    "@narumitw/pi-lsp": "0.49.6",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "3.3.1",
    "linkedom": "^0.16.11",
    "lovely-mermaid": "^0.3.3",
    "open": "^10.2.0",
    "pi-subagents": "0.63.0",
    "recheck": "^4.5.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3",
    "turndown": "^7.2.4",
    "undici": "^6.28.1",
    "unpdf": "^1.8.1",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.86.1",
    "@earendil-works/pi-coding-agent": ">=0.86.1",
    "@earendil-works/pi-tui": ">=0.86.1",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/capabilities.ts",
      "./extensions/background.ts",
      "./extensions/pix-anthropic/index.ts",
      "./extensions/computer.ts",
      "./extensions/context.ts",
      "./extensions/export.ts",
      "./extensions/fast-mode.ts",
      "./extensions/footer.ts",
      "./extensions/goal.ts",
      "./extensions/mermaid.ts",
      "./extensions/mcp.ts",
      "./extensions/question.ts",
      "./extensions/smart-editor.ts",
      "./extensions/todo.ts",
      "./extensions/upstream-tools.ts",
      "./extensions/tool.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "agents",
    "docs",
    "extensions",
    "scripts",
    "src",
    "vendor",
    "tests",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bundledDependencies": [
    "@narumitw/pi-lsp",
    "pi-subagents"
  ],
  "bundleDependencies": [
    "@narumitw/pi-lsp",
    "pi-subagents"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1"
  }
}
