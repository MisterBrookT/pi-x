{
  "name": "@brooktang/pi-x",
  "version": "0.7.2",
  "description": "A focused Pi package: web access, bounded subagents, visible todo tracking, computer use, LSP diagnostics, and health checks.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "subagents",
    "web-search",
    "lsp",
    "computer-use"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisterBrookT/pi-x.git"
  },
  "homepage": "https://github.com/MisterBrookT/pi-x#readme",
  "bugs": {
    "url": "https://github.com/MisterBrookT/pi-x/issues"
  },
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "deploy:relay": "node scripts/deploy-relay.mjs",
    "build:desktop": "node scripts/build-desktop-vendor.mjs",
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "check": "node --test && npm run prompt:snapshot",
    "test:tui": "node --test tests/tui-*.test.mjs",
    "test:remote-ui": "node scripts/verify-remote-ui.mjs",
    "test:relay-ui": "node scripts/verify-relay-ui.mjs",
    "test:relay-session": "node --test scripts/verify-relay-session.mjs",
    "test:relay-workflow": "node --test scripts/verify-relay-workflow.mjs",
    "prompt:snapshot": "node scripts/render-prompt-comparison.mjs",
    "smoke:anthropic": "node scripts/smoke-pix-anthropic.mjs",
    "postinstall": "node scripts/apply-pi-subagents-patch.mjs",
    "sim": "scripts/sim",
    "test:perf": "node --test --test-reporter=spec tests/remote-perf.test.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@narumitw/pi-lsp": "0.49.6",
    "@novnc/novnc": "1.7.0",
    "jsonc-parser": "3.3.1",
    "linkedom": "^0.16.11",
    "lovely-mermaid": "^0.3.3",
    "marked": "18.0.11",
    "open": "^10.2.0",
    "pi-subagents": "0.63.0",
    "recheck": "^4.5.0",
    "remend": "^1.4.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.1",
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "@earendil-works/pi-tui": ">=0.99.1",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./plugins/core/capabilities.ts",
      "./plugins/chat/index.ts",
      "./plugins/background/index.ts",
      "./plugins/pix-anthropic/index.ts",
      "./plugins/computer/index.ts",
      "./plugins/context/index.ts",
      "./plugins/export/index.ts",
      "./plugins/fast-mode/index.ts",
      "./plugins/footer/index.ts",
      "./plugins/goal/index.ts",
      "./plugins/mermaid/index.ts",
      "./plugins/question/index.ts",
      "./plugins/remote/index.ts",
      "./plugins/editor/index.ts",
      "./plugins/terminal-support/index.ts",
      "./plugins/todo/index.ts",
      "./plugins/subagents/index.ts",
      "./plugins/web/index.ts",
      "./plugins/core/tool.ts",
      "./plugins/foryou/index.ts",
      "./plugins/artifacts/index.ts",
      "./plugins/mac/index.ts"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "agents",
    "docs",
    "patches",
    "relay/src/index.ts",
    "relay/wrangler.jsonc",
    "scripts",
    "plugins",
    "tests",
    "LICENSE",
    "README.md",
    "ROADMAP.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bundledDependencies": [
    "@narumitw/pi-lsp",
    "pi-subagents"
  ],
  "bundleDependencies": [
    "@narumitw/pi-lsp",
    "pi-subagents"
  ],
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0"
  }
}
